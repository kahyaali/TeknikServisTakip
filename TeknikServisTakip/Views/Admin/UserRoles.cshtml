

@{
    ViewData["Title"] = "Kullanıcı Rolleri";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="fas fa-user-tag me-2"></i> Kullanıcı Rolleri</h1>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Kullanıcı Rolleri</h3>
        </div>
        <div class="card-body">
            <table id="userRolesTable" class="table table-bordered table-hover" style="font-size: 12px; margin-bottom: 0;">
                <thead class="table-dark">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Rolleri</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- AJAX ile doldurulacak -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    #userRolesTable {
        visibility: hidden;
    }
    #userRolesTable.dataTable {
        visibility: visible !important;
    }

        #userRolesTable td, #userRolesTable th {
            padding: 5px 10px !important; 
            vertical-align: middle;
            white-space: nowrap;
        }
</style>




@section Scripts {
    <script>
               let userRolesTable;

        $(document).ready(function () {
            initDataTable();
        });

        function initDataTable() {
            if ($.fn.dataTable.isDataTable('#userRolesTable')) {
                $('#userRolesTable').DataTable().destroy();
            }

            userRolesTable = $('#userRolesTable').DataTable({
                processing: true,
                serverSide: true,
                deferRender: true,
                ajax: {
                    url: '/Admin/GetUserRolesJson',
                    type: 'POST',
                    data: function (d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search?.value || ''
                        };
                    }
                },
                columns: [
                    { data: 'fullName' },
                    { data: 'email' },
                    {
                        data: 'roles',
                        render: function (data) {
                            if (!data || data.length === 0) {
                                return '<span class="badge bg-secondary">Rol yok</span>';
                            }

                            return data.map(r =>
                                `<span class="badge bg-primary me-1">${r}</span>`
                            ).join('');
                        }
                    },
                    {
                        data: null,
                        render: function (data) {
                            return `<a href="/Admin/AssignRole?userId=${data.userId}"
                                        class="btn btn-sm btn-primary">
                                        <i class="fas fa-tag"></i> Rol Ata
                                    </a>`;
                        }
                    }
                ],
                pageLength: 5,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                language: { url: '/datatables/tr.json' },
                order: [[0, 'asc']],
                responsive: true
                   
            });
        }
    </script>
}