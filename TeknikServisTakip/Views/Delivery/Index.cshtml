    }

    [data-theme="light"] .repair-table-wrapper {
        background: white;
    }

    [data-theme="dark"] .repair-table-wrapper {
        background: #1e293b;
    }

    .repair-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }


        .repair-table th,
        .repair-table td {
            padding: 14px 15px;
            text-align: left;
            vertical-align: middle;
        }

     
