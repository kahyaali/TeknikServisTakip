@{
    ViewData["Title"] = "Ürün Teslim";
}



<div class="delivery-container">
    <div class="page-header">
        <h1><i class="fas fa-truck me-3"></i> Ürün Teslimatı</h1>
        <p>Müşteri No veya Takip Kodu ile arama yapın, teslim edilecek ürünü seçin</p>
    </div>
    
    <!-- Arama Kartı -->
    <div class="search-card">
        <div class="search-tabs">
            <div class="search-tab active" data-tab="customer">Müşteri No ile Ara</div>
            <div class="search-tab" data-tab="tracking">Takip Kodu ile Ara</div>
        </div>
        
        <div id="customerSearch" class="search-group active">
            <input type="text" id="customerNumber" class="form-control" placeholder="Müşteri No giriniz (Örn: MUS-202600001)" />
            <button id="btnSearchCustomer" class="btn-search"><i class="fas fa-search"></i> Ara</button>
        </div>
        
        <div id="trackingSearch" class="search-group">
            <input type="text" id="trackingCode" class="form-control" placeholder="Takip Kodu giriniz (Örn: TAK-2026-0001)" />
            <button id="btnSearchTracking" class="btn-search"><i class="fas fa-search"></i> Ara</button>
        </div>

      
    </div>
    
    <!-- Müşteri Bilgi Kartı -->
    <div id="customerInfo" class="customer-info-card">
        <div class="row">
            <div class="col-md-3">
                <small>Müşteri Adı</small>
                <p class="fw-bold mb-0" id="customerName">-</p>
            </div>
            <div class="col-md-3">
                <small>Telefon</small>
                <p class="fw-bold mb-0" id="customerPhone">-</p>
            </div>
            <div class="col-md-3">
                <small>Müşteri No</small>
                <p class="fw-bold mb-0" id="customerNo">-</p>
            </div>  
            <div class="col-md-3">
        
                <small>Firma</small>
                <p class="fw-bold mb-0" id="customerCompany">-</p>
            </div>
        </div>
       
    </div>
    
    <!-- Ürün Tablosu -->
    <div id="repairTableWrapper" class="repair-table-wrapper">
        <table id="repairTable" class="repair-table">
            <thead>
                <tr>
                    <th>Takip Kodu</th>
                    <th>Ürün Adı</th>
                    <th>Marka/Model</th>
                    <th>Geliş Tarihi</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody id="repairTableBody">
            </tbody>
        </table>
    </div>
    
    <!-- Teslim Formu -->
    <div id="deliveryForm" class="delivery-form">
        <h4 class="mb-3"><i class="fas fa-clipboard-list"></i> Teslim Bilgileri</h4>
        <div id="selectedRepairInfo" class="selected-repair"></div>
        
        <input type="hidden" id="selectedRepairId" />
        
        <div class="delivery-type-group">
            <label>
                <input type="radio" name="deliveryType" value="Cargo" checked /> <i class="fas fa-truck"></i> Kargo
            </label>
            <label>
                <input type="radio" name="deliveryType" value="InPerson" /> <i class="fas fa-handshake"></i> Elden Teslim
            </label>
        </div>
        
        <!-- Kargo Alanları -->
        <div id="cargoFields" class="cargo-fields active">
            <div class="form-group">
                <label class="form-label">Kargo Firması *</label>
                <input type="text" id="cargoCompany" class="form-control" placeholder="Örn: Yurtiçi Kargo, MNG, Aras..." />
            </div>
            <div class="form-group">
                <label class="form-label">Kargo Takip No</label>
                <input type="text" id="cargoTrackingNumber" class="form-control" placeholder="Takip numarası" />
            </div>
            <div class="form-group">
                <label class="form-label">Alıcı Ad Soyad *</label>
                <input type="text" id="recipientName" class="form-control" placeholder="Teslim alacak kişi" />
            </div>
            <div class="form-group">
                <label class="form-label">Alıcı Telefon</label>
                <input type="tel" id="recipientPhone" class="form-control phone-mask"
                placeholder="05XX XXX XX XX" 
                       value="@(Model?.PhoneNumber.FormatPhoneSafe())" />
                <small class="text-muted">Opsiyonel - 05XX XXX XX XX</small>
            </div>
        </div>
        
        <!-- Elden Teslim Alanları -->
        <div id="inpersonFields" class="inperson-fields">
            <div class="form-group">
                <label class="form-label">Teslim Alan Ad Soyad *</label>
                <input type="text" id="receiverName" class="form-control" placeholder="Teslim alan kişi" />
            </div>
            <div class="form-group">
                <label class="form-label">Teslim Alan Telefon</label>
                <input type="tel" id="receiverPhone" class="form-control phone-mask"
                placeholder="05XX XXX XX XX" 
                       value="@(Model?.PhoneNumber.FormatPhoneSafe())" />
                <small class="text-muted">Opsiyonel - 05XX XXX XX XX</small>
            </div>
        </div>
        
        <div class="form-group">
            <label class="form-label">Not (Opsiyonel)</label>
            <textarea id="note" class="form-control" rows="2" placeholder="Teslim ile ilgili not..."></textarea>
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <button id="btnDeliver" class="btn btn-success w-100"><i class="fas fa-check-circle"></i> Teslim Et</button>
            </div>
            <div class="col-md-6">
                <button id="btnCancel" class="btn btn-secondary w-100"><i class="fas fa-times"></i> İptal</button>
            </div>
        </div>
    </div>
</div>


<style>

    

    .delivery-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }


    [data-theme="light"] .delivery-container {
        background-color: #f8fafc;
    }

    [data-theme="dark"] .delivery-container {
        background-color: #0f172a;
    }


    .page-header {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        border-radius: 20px;
        padding: 25px 30px;
        margin-bottom: 30px;
        color: white;
    }

    [data-theme="dark"] .page-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }

    .page-header h1 {
        font-size: 28px;
        margin: 0;
        font-weight: 600;
    }

    .page-header p {
        margin: 5px 0 0;
        opacity: 0.9;
        font-size: 14px;
    }


    .search-card {
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    [data-theme="light"] .search-card {
        background: white;
    }

    [data-theme="dark"] .search-card {
        background: #1e293b;
    }

    .search-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 10px;
    }

    [data-theme="dark"] .search-tabs {
        border-bottom-color: #334155;
    }

    .search-tab {
        padding: 8px 20px;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s;
    }

    [data-theme="light"] .search-tab {
        background: #f1f5f9;
    }

    [data-theme="dark"] .search-tab {
        background: #334155;
        color: #e2e8f0;
    }

    .search-tab.active {
        background: #3b82f6;
        color: white;
    }

    .search-group {
        display: none;
    }

        .search-group.active {
            display: flex;
            gap: 10px;
        }

        .search-group input {
            flex: 1;
            padding: 12px;
            border-radius: 10px;
        }

    [data-theme="light"] .search-group input {
        border: 1px solid #ddd;
        background: white;
    }

    [data-theme="dark"] .search-group input {
        border: 1px solid #334155;
        background: #0f172a;
        color: #e2e8f0;
    }

    .btn-search {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-search:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }


    .customer-info-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
