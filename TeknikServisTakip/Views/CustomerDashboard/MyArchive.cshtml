
@model IEnumerable<Entities.Concrete.ArchiveRepair>
@{
    ViewData["Title"] = "Tamir Arşivim";
}

<div class="container-fluid">
    <div class="archive-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h1><i class="fas fa-archive me-3"></i> Tamir Arşivim</h1>
                <p>Teslim edilen tamirlerinizin geçmiş kayıtları</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/CustomerDashboard/Index" class="btn btn-light">
                    <i class="fas fa-arrow-left me-2"></i> Dashboard'a Dön
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <table id="archiveTable" class="table table-bordered table-archive">
                <thead>
                    <tr>
                        <th>Takip Kodu</th>
                        <th>Ürün Bilgisi</th>
                        <th>Geliş Tarihi</th>
                        <th>Teslim Tarihi</th>
                        <th>Personel</th>
                        <th>Ücret</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- AJAX ile doldurulacak -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#archiveTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/CustomerDashboard/GetMyArchiveJson',
                    type: 'POST',
                    data: function(d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search?.value || ''
                        };
                    }
                },
                language: { url: '/datatables/tr.json' },
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>" +
                     "<'row'<'col-sm-12'B>>",
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel me-1"></i> Excel Aktar',
                        className: 'btn btn-success btn-sm',
                        filename: 'Tamir_Arsivim_' + new Date().toLocaleDateString('tr-TR'),
                        title: 'TAMİR ARŞİVİM',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5],
                            format: {
                                header: function(data, columnIdx) {
                                    var titles = ['Takip Kodu', 'Ürün Bilgisi', 'Geliş Tarihi', 'Teslim Tarihi', 'Personel', 'Ücret'];
                                    return titles[columnIdx];
                                },
                                body: function(data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '');
                                }
                            }
                        },
                        customize: function(xlsx) {
                            var sheet = xlsx.xl.worksheets['sheet1.xml'];
                            $('row:first c', sheet).attr('s', '2');
                        }
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="fas fa-file-pdf me-1"></i> PDF İndir',
                        className: 'btn btn-danger btn-sm',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        filename: 'Tamir_Arsivim_' + new Date().toLocaleDateString('tr-TR'),
                        title: 'TAMİR ARŞİVİM',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5],
                            format: {
                                body: function(data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '');
                                }
                            }
                        },
                        customize: function(doc) {
                            // Sayfa kenar boşlukları
                            doc.pageMargins = [30, 80, 30, 40];
                            
                            // Header (Her sayfada üst bilgi)
                            doc['header'] = function() {
                                return {
                                    columns: [
                                        {
                                            alignment: 'left',
                                            text: 'TEKNİK SERVİS TAKİP SİSTEMİ',
                                            fontSize: 12,
                                            bold: true,
                                            color: '#0d6efd'
                                        },
                                        {
                                            alignment: 'right',
                                            text: 'Rapor No: ' + new Date().getTime(),
                                            fontSize: 8,
                                            color: '#6c757d'
                                        }
                                    ],
                                    margin: [30, 20, 30, 0]
                                };
                            };
                            
                            // Ana Başlık
                            doc.content.splice(0, 0, {
                                text: 'TAMİR ARŞİVİM',
                                fontSize: 16,
                                bold: true,
                                alignment: 'center',
                                margin: [0, 0, 0, 10]
                            });
                            
                            // Alt başlık / Tarih
                            doc.content.splice(1, 0, {
                                text: 'Rapor Tarihi: ' + new Date().toLocaleString('tr-TR'),
                                fontSize: 9,
                                alignment: 'center',
                                color: '#6c757d',
                                margin: [0, 0, 0, 20]
                            });
                            
                            // Tablo genişlikleri
                            var tableIndex = doc.content.findIndex(function(item) { return item.table; });
                            if (tableIndex !== -1) {
                                doc.content[tableIndex].table.widths = ['15%', '30%', '12%', '12%', '16%', '15%'];
                                
                                // Tablo başlık stili
                                doc.content[tableIndex].table.body[0].forEach(function(cell) {
                                    cell.fillColor = '#0d6efd';
                                    cell.color = 'white';
                                    cell.alignment = 'center';
                                    cell.bold = true;
                                    cell.fontSize = 10;
                                });
                                
                                // Veri satırları stili
                                for (var i = 1; i < doc.content[tableIndex].table.body.length; i++) {
                                    var row = doc.content[tableIndex].table.body[i];
                                    for (var j = 0; j < row.length; j++) {
                                        if (j === 2 || j === 3 || j === 5) { // Tarih ve Ücret sütunları
                                            row[j].alignment = 'center';
                                        } else {
                                            row[j].alignment = 'left';
                                        }
                                        row[j].fontSize = 9;
                                    }
                                    // Zebra deseni
                                    if (i % 2 === 0) {
                                        row.forEach(function(cell) {
                                            cell.fillColor = '#f8f9fa';
                                        });
                                    }
                                }
                            }
                            
                            // Tablo çizgileri
                            if (tableIndex !== -1) {
                                doc.content[tableIndex].layout = {
                                    hLineWidth: function(i) { return 0.5; },
                                    vLineWidth: function(i) { return 0.5; },
                                    hLineColor: function(i) { return '#dee2e6'; },
                                    vLineColor: function(i) { return '#dee2e6'; },
                                    paddingLeft: function(i) { return 6; },
                                    paddingRight: function(i) { return 6; },
                                    paddingTop: function(i) { return 8; },
                                    paddingBottom: function(i) { return 8; }
                                };
                            }
                            
                            // Footer
                            doc['footer'] = function(page, pages) {
                                return {
                                    columns: [
                                        { text: 'Teknik Servis Takip Sistemi', alignment: 'left', fontSize: 8, color: '#6c757d' },
                                        { text: 'Sayfa ' + page + ' / ' + pages, alignment: 'right', fontSize: 8, color: '#6c757d' }
                                    ],
                                    margin: [30, 0, 30, 20]
                                };
                            };
                        }
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print me-1"></i> Yazdır',
                        className: 'btn btn-secondary btn-sm',
                        exportOptions: {
                            columns: [0, 1, 2, 3, 4, 5],
                            format: {
                                body: function(data, row, column, node) {
                                    return data.replace(/<[^>]*>/g, '');
                                }
                            }
                        },
                        title: 'Tamir Arşivim',
                        customize: function(win) {
                            $(win.document.body).find('table').addClass('table table-bordered');
                            $(win.document.body).find('caption').css('font-size', '16px').css('font-weight', 'bold');
                        }
                    }
                ],
                pageLength: 10,
                order: [[2, 'desc']],
                columns: [
                    {
                        data: null,
                        render: function(data) {
                            return '<strong>' + data.trackingCode + '</strong> <span class="badge-delivered ms-2">Teslim Edildi</span>';
                        }
                    },
                    {
                        data: null,
                        render: function(data) {
                            var html = '<strong>' + data.productName + '</strong>';
                            if (data.productBrand) {
                                html += '<br /><small class="text-muted">' + data.productBrand + ' ' + data.productModel + '</small>';
                            }
                            return html;
                        }
                    },
                    { data: 'receivedDate' },
                    { data: 'deliveryDate' },
                    { data: 'personel' },
                       {
            data: null,
            render: function(data) {
                return '<span class="fw-bold text-success">' + data.currencySymbol + ' ' + data.price + ' <small class="text-muted">(' + data.currency + ')</small></span>';
            }
        },
                    {
                        data: null,
                        render: function(data) {
                            return '<a href="/CustomerDashboard/MyArchiveDetail/' + data.id + '" class="btn-detail"><i class="fas fa-eye"></i> Detay</a>';
                        }
                    }
                ]
            });
        });
    </script>
}

<style>
    .archive-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 25px 30px;
        margin-bottom: 30px;
        color: white;
    }

    .badge-delivered {
        background: #10b981;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .btn-detail {
        background: #0d6efd;
        color: white;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 12px;
        text-decoration: none;
    }

        .btn-detail:hover {
            background: #0b5ed7;
            color: white;
        }

    .btn-success, .btn-danger, .btn-secondary {
        margin: 0 2px;
    }
</style>