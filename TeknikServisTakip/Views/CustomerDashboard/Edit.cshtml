@using TeknikServisTakip.Helpers
@model Entities.Concrete.AppUser
@{
    ViewData["Title"] = "Profil Düzenle";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-user-edit me-2"></i> Profil Bilgilerim</h4>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Ad Soyad *</label>
                        <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label">E-posta *</label>
                        <input type="email" name="email" class="form-control" value="@Model.Email" required />
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Telefon *</label>
                        <input type="tel" name="phoneNumber" class="form-control" 
                               value="@(Model?.PhoneNumber.FormatPhoneSafe())"
                        placeholder="05XX XXX XX XX" required />
                        <small class="text-muted">Format: 05XX XXX XX XX</small>
                    </div>
                    
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Adres *</label>
                        <textarea name="address" class="form-control" rows="2" required>@Model.Address</textarea>
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Şehir *</label>
                        <input type="text" name="city" class="form-control" value="@Model.City" required />
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label">İlçe *</label>
                        <input type="text" name="district" class="form-control" value="@Model.District" required />
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Posta Kodu</label>
                        <input type="text" name="postalCode" class="form-control" value="@Model.PostalCode" placeholder="34000" />
                        <small class="text-muted">5 haneli</small>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">TC Kimlik No</label>
                        <input type="text" name="identityNumber" class="form-control" value="@Model.IdentityNumber" placeholder="11 haneli" />
                        <small class="text-muted">Opsiyonel - 11 haneli</small>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i> Bilgilerimi Güncelle
                    </button>
                    <a href="/CustomerDashboard/Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i> Dashboard'a Dön
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Telefon formatı için kontrol
        document.querySelector('input[name="phoneNumber"]').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            
            // Maksimum 11 haneli olabilir
            if (value.length > 11) {
                value = value.slice(0, 11);
            }
            
            // 4+3+2+2 formatı için
            if (value.length >= 4) {
                let match = value.match(/^(\d{4})(\d{3})(\d{2})(\d{2})$/);
                if (match) {
                    e.target.value = `${match[1]} ${match[2]} ${match[3]} ${match[4]}`;
                } else if (value.length >= 7) {
                    // Kısmi format
                    let part1 = value.slice(0, 4);
                    let part2 = value.slice(4, 7);
                    let part3 = value.slice(7, 9);
                    let part4 = value.slice(9, 11);
                    e.target.value = [part1, part2, part3, part4].filter(p => p).join(' ').trim();
                } else if (value.length >= 4) {
                    e.target.value = value.slice(0, 4) + (value.length > 4 ? ' ' + value.slice(4) : '');
                }
            } else {
                e.target.value = value;
            }
        });
    </script>
}