


@model Entities.Concrete.ArchiveRepair
@using TeknikServisTakip.Helpers
@{
    ViewData["Title"] = "Arşiv Detayı";

    var currency = Model.Currency ?? "TRY";
    var currencySymbol = CurrencyHelper.GetSymbol(currency);
}

<div class="container-fluid">
    <div class="detail-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h4 class="mb-1"><i class="fas fa-archive me-2"></i> Arşiv Kaydı Detayı</h4>
                <p class="mb-0 opacity-75">Teslim edilen tamir bilgileriniz</p>
            </div>
            <div class="mt-2 mt-md-0">
                <a href="/CustomerDashboard/MyArchive" class="btn btn-light btn-sm">
                    <i class="fas fa-arrow-left"></i> Arşive Dön
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="info-card">
                <h5><i class="fas fa-info-circle text-primary me-2"></i> Ürün Bilgileri</h5>
                <hr />
                <div class="row mb-3">
                    <div class="col-5 info-label">Takip Kodu</div>
                    <div class="col-7 info-value"><strong>@Model.TrackingCode</strong> <span class="badge-delivered ms-2">Teslim Edildi</span></div>
                </div>
                <div class="row mb-3">
                    <div class="col-5 info-label">Ürün Adı</div>
                    <div class="col-7 info-value">@Model.ProductName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-5 info-label">Marka / Model</div>
                    <div class="col-7 info-value">@Model.ProductBrand @Model.ProductModel</div>
                </div>
                <div class="row mb-3">
                    <div class="col-5 info-label">Seri No</div>
                    <div class="col-7 info-value">@(string.IsNullOrEmpty(Model.SerialNumber) ? "-" : Model.SerialNumber)</div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="info-card">
                <h5><i class="fas fa-calendar-alt text-success me-2"></i> Tarih & Personel</h5>
                <hr />
                <div class="row mb-3">
                    <div class="col-5 info-label">Geliş Tarihi</div>
                    <div class="col-7 info-value">@Model.ReceivedDate.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-5 info-label">Teslim Tarihi</div>
                    <div class="col-7 info-value">@(Model.DeliveryDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-5 info-label">Tamir Eden Personel</div>
                    <div class="col-7 info-value">@(Model.Personel?.FullName ?? "-")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-5 info-label">Ücret</div>
                    <div class="col-7 info-value">
                        <span class="fw-bold text-success fs-5">
                            @currencySymbol @Model.Price.ToString("N2")
                        </span>
                        <small class="text-muted">(@currency)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- NOTLAR -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="info-card">
                <h5><i class="fas fa-edit text-secondary me-2"></i> Açıklamalar ve Notlar</h5>
                <hr />
                <div class="mb-3">
                    <div class="fw-bold mb-2">
                        <i class="fas fa-exclamation-triangle text-warning me-1"></i> Arıza Açıklaması
                    </div>
                    <div class="p-2 bg-light rounded">
                        @(string.IsNullOrEmpty(Model.ProblemDescription) ? "-" : Model.ProblemDescription)
                    </div>
                </div>
                <div class="mb-3">
                    <div class="fw-bold mb-2">
                        <i class="fas fa-user-cog text-info me-1"></i> Personel Notu
                    </div>
                    <div class="p-2 bg-light rounded">
                        @(string.IsNullOrEmpty(Model.InternalNote) ? "-" : Model.InternalNote)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KULLANILAN MALZEMELER -->
@{
    var materials = ViewBag.Materials as List<Entities.Concrete.RepairMaterial>;
}
<div class="row mt-4">
    <div class="col-12">
        <div class="info-card">
            <h5><i class="fas fa-cubes text-success me-2"></i> Kullanılan Malzemeler</h5>
            <hr />
            @if (materials != null && materials.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr class="table-light">
                                <th>Ürün Adı</th>
                                <th>Miktar</th>
                                <th>Açıklama</th>
                                <th>Kullanım Tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in materials)
                            {
                                    <tr>
                                        <td>
                                            @if (material.MaterialType == "External")
                                            {
                                                <span class="badge bg-info">@material.ExternalProductName</span>
                                                <span class="badge bg-secondary ms-1">Dışarıdan</span>
                                            }
                                            else
                                            {
                                                @(material.Product?.ProductName ?? "-")
                                            }
                                        </td>
                                        <td>@material.Quantity</td>
                                        <td>@(material.Description ?? "-")</td>
                                        <td>@material.UsedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="fas fa-box-open fa-2x mb-2 d-block"></i>
                    <span>Bu tamirde kullanılan malzeme bulunmamaktadır.</span>
                </div>
            }
        </div>
    </div>
</div>

    <!-- BUTONLAR -->
    <div class="row mt-4">
        <div class="col-12 text-center">
            <div class="btn-group" role="group">
                <a href="/CustomerDashboard/ExportArchiveToExcel/@Model.Id" class="btn btn-success" target="_blank">
                    <i class="fas fa-file-excel me-1"></i> Excel İndir
                </a>
                <a href="/CustomerDashboard/ExportArchiveToPdf/@Model.Id" class="btn btn-danger" target="_blank">
                    <i class="fas fa-file-pdf me-1"></i> PDF İndir
                </a>
                <a href="/CustomerDashboard/PrintArchiveDetail/@Model.Id" class="btn btn-secondary" target="_blank">
                    <i class="fas fa-print me-1"></i> Yazdır
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 25px 30px;
        margin-bottom: 30px;
        color: white;
    }

    .info-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border: 1px solid #e9ecef;
        height: 100%;
    }

    .badge-delivered {
        background: #10b981;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .info-label {
        font-weight: 600;
        color: #6c757d;
    }

    .info-value {
        font-weight: 500;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .rounded {
        border-radius: 10px !important;
    }

    .btn-group .btn {
        margin: 0 5px;
        padding: 8px 20px;
    }

    /* Dark mode desteği */
    [data-theme="dark"] .info-card {
        background: #1e293b;
        border-color: #334155;
    }

    [data-theme="dark"] .info-label {
        color: #94a3b8;
    }

    [data-theme="dark"] .info-value {
        color: #e2e8f0;
    }

    [data-theme="dark"] .bg-light {
        background-color: #0f172a !important;
    }

    [data-theme="dark"] .table-bordered {
        border-color: #334155;
    }

        [data-theme="dark"] .table-bordered th,
        [data-theme="dark"] .table-bordered td {
            border-color: #334155;
        }

    [data-theme="dark"] .table-light {
        background-color: #0f172a;
    }

        [data-theme="dark"] .table-light th {
            background-color: #0f172a;
            color: #e2e8f0;
        }
</style>