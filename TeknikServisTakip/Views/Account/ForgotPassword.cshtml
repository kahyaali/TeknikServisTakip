@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark text-center">
                <h4 class="mb-0"><i class="fas fa-key"></i> Şifremi Unuttum</h4>
            </div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">@ViewBag.Success</div>
                }

                @if (ViewBag.Success == null)
                {
                    <p class="text-muted">E-posta adresinizi girin, size şifre sıfırlama linki gönderelim.</p>

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">E-posta Adresi</label>
                            <input type="email" name="email" class="form-control" required autofocus />
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Link Gönder</button>
                    </form>
                }

                <hr />
                <div class="text-center">
                    <a asp-action="Login">Giriş sayfasına dön</a>
                </div>
            </div>
        </div>
    </div>
</div>