@{
    ViewData["Title"] = "Erişim Engellendi - 403";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="fas fa-ban text-danger" style="font-size: 80px;"></i>
                    </div>
                    <h1 class="display-1 fw-bold text-danger">403</h1>
                    <h2 class="mb-3">Erişim Engellendi!</h2>
                    <p class="text-muted mb-4">
                        Bu sayfaya erişim yetkiniz bulunmamaktadır.
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span>Sayın <strong>@User.Identity.Name</strong>, bu işlem için yeterli yetkiniz yok.</span>
                        }
                        else
                        {
                            <span>Lütfen giriş yapın veya yöneticinizle iletişime geçin.</span>
                        }
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/" class="btn btn-primary">
                            <i class="fas fa-home"></i> Ana Sayfa
                        </a>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a href="/Account/Login" class="btn btn-outline-secondary">
                                <i class="fas fa-sign-in-alt"></i> Giriş Yap
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>