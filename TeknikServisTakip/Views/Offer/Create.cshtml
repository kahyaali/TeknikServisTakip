@* 
@using System.Globalization
@using TeknikServisTakip.Helpers
@model TeknikServisTakip.Models.ViewModels.OfferFormViewModel

@{
    ViewData["Title"] = "Teklif Hesaplama Ekranı";
}

<style>
    
    .alert-danger:empty,
    .alert-danger > ul:empty {
        display: none !important;
    }
</style>

<div class="container-fluid mt-3">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="fas fa-calculator"></i> Profesyonel Teklif ve Maliyetlendirme Motoru</h4>
            <small>Müşteri: <strong>@Model.CustomerName</strong> (@Model.CustomerNumber) @(!string.IsNullOrEmpty(Model.CompanyName) ? $"| Firma: {Model.CompanyName}" : "")</small>
        </div>
        <div class="card-body">
            <form asp-action="Create" asp-controller="Offer" method="post" id="offerForm">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CustomerNumber" />
                <input type="hidden" asp-for="CustomerName" />
                <input type="hidden" asp-for="CompanyName" />
                <input type="hidden" asp-for="ParentOfferId" />

                <div asp-validation-summary="All" class="alert alert-danger fw-bold d-none" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-9">
                        <label class="form-label fw-bold">Teklif Şartları ve Müşteri Notu</label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">İşlem Para Birimi</label>
                        <select asp-for="Currency" class="form-select fs-5 fw-bold text-primary" id="globalCurrency">
                            @foreach (var curr in CurrencyHelper.GetCurrencyList())
                            {
                                <option value="@curr.Value">@curr.Text</option>
                            }
                        </select>
                    </div>
                </div>

                @for (int i = 0; i < Model.ProductGroups.Count; i++)
                {
                    <div class="card mb-4 border-secondary product-group-card">
                        <div class="card-header bg-light fw-bold text-dark fs-5">
                            <i class="fas fa-laptop"></i> Ürün: @Model.ProductGroups[i].ProductName
                            <input type="hidden" asp-for="ProductGroups[i].RepairItemId" />
                            <input type="hidden" asp-for="ProductGroups[i].ProductName" />
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-bordered align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Arıza / Ekspertiz Açıklaması</th>
                                        <th width="10%" class="text-center">Miktar</th>
                                        <th width="12%" class="text-center">Birim</th>
                                        <th width="18%" class="text-end">Parça Birim Fiyatı</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int j = 0; j < Model.ProductGroups[i].Lines.Count; j++)
                                    {
                                        <tr class="line-row">
                                            <input type="hidden" asp-for="ProductGroups[i].Lines[j].ExpertiseLineId" />
                                            <input type="hidden" asp-for="ProductGroups[i].Lines[j].Quantity" />
                                            <input type="hidden" asp-for="ProductGroups[i].Lines[j].Unit" />

                                            <td>
                                                <input type="text" asp-for="ProductGroups[i].Lines[j].Description" class="form-control" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control quantity text-center fw-bold bg-light" readonly value="@Model.ProductGroups[i].Lines[j].Quantity.ToString("G29", new CultureInfo("tr-TR"))" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control text-center bg-light" readonly value="@Model.ProductGroups[i].Lines[j].Unit" />
                                            </td>
                                            <td>
                                                <div class="input-group">
                                                    <input type="number" step="0.01" min="0" asp-for="ProductGroups[i].Lines[j].UnitPrice" class="form-control unit-price text-end border-success fw-bold" value="@(Model.ProductGroups[i].Lines[j].UnitPrice > 0 ? Model.ProductGroups[i].Lines[j].UnitPrice.ToString("F2", CultureInfo.InvariantCulture) : "0.00")" />
                                                    <span class="input-group-text currency-symbol">₺</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="table-warning" style="color: #000 !important;">
                                        <td colspan="2" class="fw-bold text-end" style="color: #000 !important;">Bu Ürünün Finansal Ayarları:</td>
                                        <td colspan="2">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-md-4">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-dark text-white">İşçilik:</span>
                                                        <input type="number" step="0.01" min="0" asp-for="ProductGroups[i].LaborCost" class="form-control labor-cost text-end fw-bold" value="@(Model.ProductGroups[i].LaborCost > 0 ? Model.ProductGroups[i].LaborCost.ToString("F2", CultureInfo.InvariantCulture) : "0.00")" />
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-danger text-white">İskonto %:</span>
                                                        <input type="number" step="0.01" min="0" asp-for="ProductGroups[i].DiscountRate" class="form-control discount-rate text-center text-danger fw-bold" value="@(Model.ProductGroups[i].DiscountRate > 0 ? Model.ProductGroups[i].DiscountRate.ToString("F1", CultureInfo.InvariantCulture) : "0.0")" />
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-info text-white">KDV %:</span>
                                                        <input type="number" step="0.01" min="0" max="100" asp-for="ProductGroups[i].TaxRate" class="form-control tax-rate text-center fw-bold" value="@(Model.ProductGroups[i].TaxRate > 0 ? Model.ProductGroups[i].TaxRate.ToString("F1", CultureInfo.InvariantCulture) : "20.0")" />
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <div class="card bg-dark text-white mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center py-3">
                        <h4 class="mb-0 text-uppercase text-warning fw-bold"><i class="fas fa-file-invoice-dollar"></i> TEKLİF NET GENEL TOPLAMI:</h4>
                        <h2 class="mb-0 fw-bolder text-success" id="grandTotalLabel">0,00 ₺</h2>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="/ExpertiseApproval/Index" class="btn btn-secondary btn-lg"><i class="fas fa-arrow-left"></i> Havuza Dön</a>
                    <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow"><i class="fas fa-paper-plane"></i> Teklifi Kaydet ve Yayınla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
           
            var $summary = $('div[asp-validation-summary="All"]');
            if ($summary.find('ul li').length > 0 && $summary.find('ul li').text().trim() !== "") {
                $summary.removeClass('d-none');
            }

            $('#offerForm').on('invalid-form.validate', function() {
                $summary.removeClass('d-none');
            });

            var symbols = { TRY: '₺', USD: '$', EUR: '€', GBP: '£' };

            function calculateTotals() {
                let currency = $('#globalCurrency').val();
                let symbol = symbols[currency] || '₺';
                $('.currency-symbol').text(symbol);

                let globalGrandTotal = 0;

                $('.product-group-card').each(function() {
                    let productLinesTotal = 0;

                    $(this).find('.line-row').each(function() {
                        let qtyRaw = $(this).find('.quantity').val() || "0";
                        let qty = parseFloat(qtyRaw.replace(/\./g, '').replace(',', '.')) || 0;

                        let price = parseFloat($(this).find('.unit-price').val()) || 0;
                        productLinesTotal += (qty * price);
                    });

                    let labor = parseFloat($(this).find('.labor-cost').val()) || 0;
                    let discountRate = parseFloat($(this).find('.discount-rate').val()) || 0;
                    let taxRate = parseFloat($(this).find('.tax-rate').val()) || 0;

                    let base = productLinesTotal + labor;
                    let discAmt = base * (discountRate / 100);
                    let afterDisc = base - discAmt;
                    let taxAmt = afterDisc * (taxRate / 100);
                    let groupTotal = afterDisc + taxAmt;

                    globalGrandTotal += groupTotal;
                });

                $('#grandTotalLabel').text(globalGrandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol);
            }

            $('#offerForm').on('input change', 'input, select', calculateTotals);
            $('#globalCurrency').change(calculateTotals);
            calculateTotals();
        });
    </script>
} *@



