@{
    ViewData["Title"] = "Logo Yönetimi";
    bool hasLogo = ViewBag.HasLogo;
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-image me-2"></i> Firma Logo Yönetimi</h5>
        </div>
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-6 text-center">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Mevcut Logo</h6>
                            @if (hasLogo)
                            {
                                <img src="/images/firmaimages/logo.png?v=@DateTime.Now.Ticks" alt="Firma Logosu" class="img-fluid" style="max-height: 150px; max-width: 100%; object-fit: contain;" />
                                <div class="mt-3">
                                    <button type="button" class="btn btn-danger" id="deleteLogoBtn">
                                        <i class="fas fa-trash me-2"></i> Logoyu Sil
                                    </button>
                                    <form id="deleteLogoForm" asp-action="DeleteLogo" method="post" style="display:none;">
                                        @Html.AntiForgeryToken()
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted py-5">
                                    <i class="fas fa-image fa-4x mb-3 d-block"></i>
                                    <span>Henüz logo yüklenmemiş</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Logo Yükle / Değiştir</h6>
                            <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" id="uploadLogoForm">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Logo Dosyası</label>
                                    <input type="file" name="logo" class="form-control" accept="image/jpeg,image/png,image/gif,image/bmp,image/svg+xml" required />
                                    <small class="text-muted">Desteklenen formatlar: JPG, PNG, GIF, BMP, SVG (Max 5MB)</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Önerilen Boyut</label>
                                    <small class="text-muted d-block">Logo en iyi görünüm için 200x100px veya 2:1 oranında olmalıdır.</small>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-upload me-2"></i> Logo Yükle / Güncelle
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <a href="/Admin/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i> Dashboard'a Dön
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Logo silme butonu SweetAlert2
            $('#deleteLogoBtn').on('click', function() {
                Swal.fire({
                    title: '<span style="color: #dc2626;">Logoyu Silmek İstediğinize Emin misiniz?</span>',
                    html: `
                        <div style="text-align: center;">
                            <i class="fas fa-exclamation-triangle" style="font-size: 48px; color: #f59e0b; margin-bottom: 15px;"></i>
                            <p style="font-size: 16px; margin-bottom: 10px;"><strong>Bu işlem geri alınamaz!</strong></p>
                            <p style="font-size: 14px; color: #6b7280;">Logoyu sildiğinizde, sistem varsayılan ikona dönecektir.<br>İstediğiniz zaman yeniden yükleyebilirsiniz.</p>
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-trash me-2"></i> Evet, Sil!',
                    cancelButtonText: '<i class="fas fa-times me-2"></i> Vazgeç',
                    reverseButtons: true,
                    customClass: {
                        popup: 'rounded-4',
                        confirmButton: 'btn btn-danger px-4 py-2',
                        cancelButton: 'btn btn-secondary px-4 py-2'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Loading göster
                        Swal.fire({
                            title: 'Siliniyor...',
                            html: 'Logo sistemden kaldırılıyor.',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        // Formu submit et
                        $('#deleteLogoForm').submit();
                    }
                });
            });
        });
    </script>
}