        @{
                    var beforeImagesJson = beforeImages != null ? Newtonsoft.Json.JsonConvert.SerializeObject(beforeImages.Select(i => i.ImagePath)) : "[]";
                    var afterImagesJson = afterImages != null ? Newtonsoft.Json.JsonConvert.SerializeObject(afterImages.Select(i => i.ImagePath)) : "[]";
        }

        var beforeImagesList = @Html.Raw(beforeImagesJson);
        var afterImagesList = @Html.Raw(afterImagesJson);

        function openSlideshow(type, index) {
            currentType = type;
            if (type === 'before') {
                currentImages = beforeImagesList;
            } else {
                currentImages = afterImagesList;
            }
            currentIndex = index;
            updateSlide();
            document.getElementById('slideshowModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function updateSlide() {
            if (currentImages && currentImages.length > 0 && currentIndex >= 0 && currentIndex < currentImages.length) {
                var imgPath = currentImages[currentIndex];
                document.getElementById('slideImage').src = imgPath;
                document.getElementById('slideCounter').innerHTML = (currentIndex + 1) + ' / ' + currentImages.length;
                document.getElementById('slideDownloadBtn').onclick = function() {
                    downloadImage(imgPath);
                };
            }
        }

        function changeSlide(direction) {
            if (currentImages && currentImages.length > 0) {
                currentIndex += direction;
                if (currentIndex < 0) currentIndex = currentImages.length - 1;
                if (currentIndex >= currentImages.length) currentIndex = 0;
                updateSlide();
            }
        }

        function closeSlideshow() {
            document.getElementById('slideshowModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function downloadImage(url) {
            fetch(url).then(response => response.blob()).then(blob => {
                const link = document.createElement('a');
                const objectURL = URL.createObjectURL(blob);
                link.href = objectURL;
                link.download = url.split('/').pop() || 'resim.jpg';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(objectURL);
                Swal.fire('Başarılı!', 'Resim indiriliyor...', 'success');
            }).catch(() => {
                var a = document.createElement('a');
                a.href = url;
                a.download = url.split('/').pop() || 'resim.jpg';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                Swal.fire('Başarılı!', 'Resim indiriliyor...', 'success');
            });
        }

        document.addEventListener('keydown', function(e) {
            var modal = document.getElementById('slideshowModal');
            if (modal.style.display === 'flex') {
                if (e.key === 'Escape') closeSlideshow();
                if (e.key === 'ArrowLeft') changeSlide(-1);
                if (e.key === 'ArrowRight') changeSlide(1);
                e.preventDefault();
            }
        });

        document.getElementById('slideshowModal').addEventListener('click', function(e) {
            if (e.target === this) closeSlideshow();
        });

        // ========== MALZEME YÖNETİMİ ==========
        function loadMaterials(repairId) {
            $.get('/Repair/GetMaterials?repairId=' + repairId, function(materials) {
                var html = '';
                if (materials.length === 0) {
                    html = '<tr><td colspan="5" class="text-center text-muted">Henüz malzeme kullanılmamış.</td></tr>';
                } else {
                    for (var i = 0; i < materials.length; i++) {
                        var m = materials[i];
                        var materialDisplay = m.materialType === 'External' ?
                            '<span class="badge bg-info">' + (m.externalProductName || m.productName) + '</span>' :
                            m.productName;
                        var typeBadge = m.materialType === 'External' ?
                            '<span class="badge bg-secondary ms-1">Dışarıdan</span>' : '';

                        html += '<tr>' +
                            '<td>' + materialDisplay + ' ' + typeBadge + '</td>' +
                            '<td>' + m.quantity + '</td>' +
                            '<td>' + (m.description || '-') + '</td>' +
                            '<td>' + m.usedAt + '</td>' +
                            '<td>' + (m.usedBy || '-') + '</td>' +
                            '</tr>';
                    }
                }
                $('#materialsList').html(html);
            }).fail(function() {
                $('#materialsList').html('<tr><td colspan="5" class="text-center text-danger">Malzemeler yüklenirken hata oluştu.</td></tr>');
            });
        }

        $(document).ready(function() {
            loadMaterials(@Model.Id);
        });
    </script>
}