@model Entities.Concrete.RepairItem
@{
    ViewData["Title"] = "Tamir Düzenle";
   
    var personels = ViewBag.Personels as IEnumerable<Entities.Concrete.Personel>;
    var customers = ViewBag.Customers as IEnumerable<Entities.Concrete.AppUser>;

    var currencySymbol = TeknikServisTakip.Helpers.CurrencyHelper.GetSymbol(Model.Currency ?? "TRY");
}


<div class="page-wrapper">
    <div class="content-wrapper">
        <h1><i class="fas fa-edit"></i> Tamir Düzenle</h1>

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        <form method="post" enctype="multipart/form-data" asp-action="Edit" asp-controller="Repair" id="editRepairForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <!-- 1. SATIR: Müşteri Bilgileri + Tamir Bilgileri -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-primary text-white">Müşteri Bilgileri</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Müşteri</label>
                                <select name="AppUserId" id="CustomerSelect" class="form-control">
                                    <option value="">-- Müşteri Seçin --</option>
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id" data-customernumber="@customer.CustomerNumber" selected="@(Model.AppUserId == customer.Id)">
                                            @customer.FullName-@customer.CustomerNumber
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Müşteri No</label>
                                <input type="text" name="CustomerNumber" id="CustomerNumber" class="form-control readonly-field" value="@Model.CustomerNumber" readonly />
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Ürün Adı</label>
                                        <input type="text" name="ProductName" class="form-control" value="@Model.ProductName" required />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Marka</label>
                                        <input type="text" name="ProductBrand" class="form-control" value="@Model.ProductBrand" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Model</label>
                                        <input type="text" name="ProductModel" class="form-control" value="@Model.ProductModel" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Seri No</label>
                                        <input type="text" name="SerialNumber" class="form-control" value="@Model.SerialNumber" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-success text-white">Tamir Bilgileri</div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Personel</label>
                                        <select name="PersonelId" class="form-control">
                                            <option value="">-- Personel Seçin --</option>
                                            @foreach (var personel in personels)
                                            {
                                                var displayText = string.IsNullOrEmpty(personel.Position?.Name) ? personel.FullName : $"{personel.FullName} - {personel.Position.Name}";
                                                <option value="@personel.Id" selected="@(Model.PersonelId == personel.Id)">@displayText</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <!-- Repair Status-->
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Durum</label>
                                        <select name="StatusId" class="form-control" asp-items="ViewBag.StatusList"></select>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Tahmini Teslim Tarihi</label>
                                        <input type="date" name="EstimatedDeliveryDate" class="form-control" value="@(Model.EstimatedDeliveryDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Ücret</label>
                                        <input type="hidden" name="Currency" value="@Model.Currency" />

                                        <div class="d-flex align-items-center position-relative">
                                            <input type="text" name="Price" class="form-control bg-light fw-bold pe-5 text-white"
                                                   value="@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture).Replace(".", ",")"
                                                   readonly style="cursor: not-allowed; background-color: rgba(255,255,255,0.05) !important;" />

                                            <span class="position-absolute end-0 me-3 fw-bold bg-secondary text-white rounded px-2 py-1" style="font-size: 14px;">
                                                @TeknikServisTakip.Helpers.CurrencyHelper.GetSymbol(Model.Currency ?? "TRY")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. SATIR: NOTLAR BÖLÜMÜ -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-warning text-dark">Notlar</div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Arıza Açıklaması</label>
                                        <textarea name="ProblemDescription" class="form-control" rows="4" required>@Model.ProblemDescription</textarea>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Müşteri Notu</label>
                                        <textarea name="CustomerNote" class="form-control" rows="4">@Model.CustomerNote</textarea>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Personel Notu (Dahili)</label>
                                        <textarea name="InternalNote" class="form-control" rows="4">@Model.InternalNote</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. SATIR: RESİMLER -->
            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-info text-white">Tamir Öncesi Resimler <span class="badge bg-light text-dark float-end">En fazla 5 resim</span></div>
                        <div class="card-body">
                            @{
                                var beforeImages = Model.RepairImages?.Where(i => i.ImageType == "Before").OrderBy(i => i.Order).ToList();
                                var existingBeforeCount = beforeImages?.Count ?? 0;
                            }
                            @if (beforeImages != null && beforeImages.Any())
                            {
                                <div class="existing-images" id="existingBeforeImages">
                                    <div class="mb-2">
                                        <button type="button" id="selectAllBeforeExisting" class="select-all-btn"> <i class="fas fa-check-double"></i>Tümünü Seç</button>
                                        <button type="button" id="deselectAllBeforeExisting" class="select-all-btn"><i class="fas fa-times-circle"></i>Seçimi Kaldır</button>
                                        <button type="button" id="deleteSelectedBeforeExisting" class="btn-delete-selected"> <i class="fas fa-trash-alt"></i>Seçilenleri Sil</button>
                                    </div>
                                    <div class="existing-images-container">
                                        @foreach (var img in beforeImages)
                                        {
                                            <div class="existing-image-item" id="beforeImg_@img.Id">
                                                <img src="@img.ImagePath" alt="Öncesi" />
                                                <button type="button" class="delete-existing-image delete-before" data-id="@img.Id">×</button>
                                                <span class="image-type-badge">Öncesi</span>
                                                <input type="checkbox" class="existing-image-checkbox before-checkbox" data-id="@img.Id" />
                                            </div>
                                        }
                                    </div>
                                </div>
                                <hr />
                            }
                            <div class="mb-3">
                                <label class="form-label">Toplu Resim Seç (Tek seferde 5'e kadar)</label>
                                <input type="file" id="multipleBeforeInput" class="form-control" accept="image/*" multiple />
                                <button type="button" id="addMultipleBefore" class="btn-multiple-image mt-2">+ Toplu Ekle</button>
                                <div id="multipleBeforeList" class="file-list"></div>
                            </div>
                            <hr />
                            <label class="form-label">Tek Tek Resim Ekle</label>
                            <div id="beforeImagesContainer"></div>
                            <button type="button" id="addBeforeImage" class="btn-add-image">+ Tek Resim Ekle</button>
                            <div class="image-counter" id="beforeCounter">@existingBeforeCount / 5 resim</div>
                            <input type="hidden" name="DeletedBeforeImageIds" id="DeletedBeforeImageIds" value="" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-info text-white">Tamir Sonrası Resimler <span class="badge bg-light text-dark float-end">En fazla 5 resim</span></div>
                        <div class="card-body">
                            @{
                                var afterImages = Model.RepairImages?.Where(i => i.ImageType == "After").OrderBy(i => i.Order).ToList();
                                var existingAfterCount = afterImages?.Count ?? 0;
                            }
                            @if (afterImages != null && afterImages.Any())
                            {
                                <div class="existing-images" id="existingAfterImages">
                                    <div class="mb-2">
                                        <button type="button" id="selectAllAfterExisting" class="select-all-btn"><i class="fas fa-check-double"></i>Tümünü Seç</button>
                                        <button type="button" id="deselectAllAfterExisting" class="select-all-btn"> <i class="fas fa-times-circle"></i>Seçimi Kaldır</button>
                                        <button type="button" id="deleteSelectedAfterExisting" class="btn-delete-selected"><i class="fas fa-trash-alt"></i>Seçilenleri Sil</button>
                                    </div>
                                    <div class="existing-images-container">
                                        @foreach (var img in afterImages)
                                        {
                                            <div class="existing-image-item" id="afterImg_@img.Id">
                                                <img src="@img.ImagePath" alt="Sonrası" />
                                                <button type="button" class="delete-existing-image delete-after" data-id="@img.Id">×</button>
                                                <span class="image-type-badge after-badge">Sonrası</span>
                                                <input type="checkbox" class="existing-image-checkbox after-checkbox" data-id="@img.Id" />
                                            </div>
                                        }
                                    </div>
                                </div>
                                <hr />
                            }
                            <div class="mb-3">
                                <label class="form-label">Toplu Resim Seç (Tek seferde 5'e kadar)</label>
                                <input type="file" id="multipleAfterInput" class="form-control" accept="image/*" multiple />
                                <button type="button" id="addMultipleAfter" class="btn-multiple-image mt-2">+ Toplu Ekle</button>
                                <div id="multipleAfterList" class="file-list"></div>
                            </div>
                            <hr />
                            <label class="form-label">Tek Tek Resim Ekle</label>
                            <div id="afterImagesContainer"></div>
                            <button type="button" id="addAfterImage" class="btn-add-image">+ Tek Resim Ekle</button>
                            <div class="image-counter" id="afterCounter">@existingAfterCount / 5 resim</div>
                            <input type="hidden" name="DeletedAfterImageIds" id="DeletedAfterImageIds" value="" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-success"><i class="fas fa-save"></i> Kaydet</button>
                <button type="button" class="btn-geri" onclick="location.href='/Repair/Index'">
                    <i class="fas fa-arrow-left"></i> Geri
                </button>
            </div>
        </form>
    </div>
</div>


<style>
    
    button.btn-remove-image {
        background: #dc3545 !important;
        color: white !important;
        border: none !important;
        width: 34px !important;
        height: 34px !important;
        border-radius: 8px !important;
        font-size: 18px !important;
        font-weight: bold !important;
        padding: 0 !important;
        margin: 2px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
</style>


