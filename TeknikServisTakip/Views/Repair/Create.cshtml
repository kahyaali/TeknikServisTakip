@using Entities.Enum
@using TeknikServisTakip.Helpers
@model Entities.Concrete.RepairItem
@{
    ViewData["Title"] = "Yeni Tamir Ekle";
    var personels = ViewBag.Personels as IEnumerable<Entities.Concrete.Personel>;
    var customers = ViewBag.Customers as IEnumerable<Entities.Concrete.AppUser>;
}



<div class="page-wrapper">
    <div class="content-wrapper">
        <h1><i class="fas fa-plus"></i> Yeni Tamir Ekle</h1>

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger">@TempData["Error"]</div>
        }

        <form method="post" enctype="multipart/form-data" asp-action="Create" asp-controller="Repair" id="addRepairForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-primary text-white">Müşteri Bilgileri</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Müşteri</label>
                                <select name="AppUserId" id="CustomerSelect" class="form-control" required>
                                    <option value="">-- Müşteri Seçin --</option>
                                    @if (customers != null && customers.Any())
                                    {
                                        foreach (var customer in customers)
                                        {
                                            <option value="@customer.Id" data-customernumber="@customer.CustomerNumber">
                                                @customer.FullName-@customer.CustomerNumber
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="">Müşteri bulunamadı</option>
                                    }
                                </select>
                            </div>
            
                            <div class="mb-3">
                                <label class="form-label">Müşteri No</label>
                                <input type="text" name="CustomerNumber" id="CustomerNumber" class="form-control readonly-field" readonly />
                            </div>
            
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Ürün Adı</label>
                                        <input type="text" name="ProductName" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Marka</label>
                                        <input type="text" name="ProductBrand" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Model</label>
                                        <input type="text" name="ProductModel" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">Seri No</label>
                                        <input type="text" name="SerialNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-success text-white">Tamir Bilgileri</div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Personel</label>
                                        <select name="PersonelId" class="form-control">
                                            <option value="">-- Personel Seçin --</option>
                                            @if (personels != null && personels.Any())
                                            {
                                                foreach (var personel in personels)
                                                {
                                                    <option value="@personel.Id">@personel.FullName</option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="">Personel bulunamadı</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!-- Repair status-->
                                @* <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Durum</label>
                                        <select name="StatusId" class="form-control">
                                            @foreach (var status in Enum.GetValues(typeof(RepairStatusEnum)))
                                            {
                                                var statusEnum = (RepairStatusEnum)status;
                                                var isSelected = (int)statusEnum == (Model?.StatusId ?? 1);
                                                if (isSelected)
                                                {
                                                    <option value="@((int)statusEnum)" selected>@statusEnum.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@((int)statusEnum)">@statusEnum.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div> *@

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Durum</label>
                                        <select name="StatusId" class="form-control" asp-items="ViewBag.StatusList"></select>
                                    </div>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Tahmini Teslim Tarihi</label>
                                        <input type="date" name="EstimatedDeliveryDate" class="form-control" />
                                    </div>
                                </div>
                               @*  <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Ücret (₺)</label>
                                        <input type="text" name="Price" class="form-control" value="0" placeholder="0,00" />
                                    </div>
                                </div> *@

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Ücret (₺)</label>
                                        <input type="text" name="Price" id="PriceInput" class="form-control text-end bg-light" value="@Model.Price.ToString("N2")" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- NOTLAR BÖLÜMÜ (Tam genişlik) -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-warning text-dark">Notlar</div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Arıza Açıklaması</label>
                                            <textarea name="ProblemDescription" class="form-control" rows="4" required></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Müşteri Notu</label>
                                            <textarea name="CustomerNote" class="form-control" rows="4"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">Personel Notu (Dahili)</label>
                                            <textarea name="InternalNote" class="form-control" rows="4"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAMİR ÖNCESİ RESİMLER -->
                <div class="col-md-6 mt-3">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <i class="fas fa-camera"></i> Tamir Öncesi Resimler
                            <span class="badge bg-light text-dark float-end">En fazla 5 resim</span>
                        </div>
                        <div class="card-body">
                            <!-- TOPLU RESİM SEÇME ALANI -->
                            <div class="mb-3">
                                <label class="form-label">Toplu Resim Seç (Tek seferde 5'e kadar)</label>
                                <input type="file" id="multipleBeforeInput" class="form-control" accept="image/*" multiple />
                                <button type="button" id="addMultipleBefore" class="btn-multiple-image mt-2">+ Toplu Ekle</button>
                                <div id="multipleBeforeList" class="file-list"></div>
                            </div>
                            
                            <hr />
                            
                            <!-- TEK TEK RESİM EKLEME ALANI -->
                            <label class="form-label">Tek Tek Resim Ekle</label>
                            <div id="beforeImagesContainer"></div>
                            <button type="button" id="addBeforeImage" class="btn-add-image">+ Tek Resim Ekle</button>
                            <div class="image-counter" id="beforeCounter">0 / 5 resim</div>
                        </div>
                    </div>
                </div>

                <!-- TAMİR SONRASI RESİMLER -->
                <div class="col-md-6 mt-3">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <i class="fas fa-check-circle"></i> Tamir Sonrası Resimler
                            <span class="badge bg-light text-dark float-end">En fazla 5 resim</span>
                        </div>
                        <div class="card-body">
                            <!-- TOPLU RESİM SEÇME ALANI -->
                            <div class="mb-3">
                                <label class="form-label">Toplu Resim Seç (Tek seferde 5'e kadar)</label>
                                <input type="file" id="multipleAfterInput" class="form-control" accept="image/*" multiple />
                                <button type="button" id="addMultipleAfter" class="btn-multiple-image mt-2">+ Toplu Ekle</button>
                                <div id="multipleAfterList" class="file-list"></div>
                            </div>
                            
                            <hr />
                            
                            <!-- TEK TEK RESİM EKLEME ALANI -->
                            <label class="form-label">Tek Tek Resim Ekle</label>
                            <div id="afterImagesContainer"></div>
                            <button type="button" id="addAfterImage" class="btn-add-image">+ Tek Resim Ekle</button>
                            <div class="image-counter" id="afterCounter">0 / 5 resim</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-success" id="submitBtn"><i class="fas fa-save"></i> Kaydet</button>
                <button type="button" class="btn-geri" onclick="location.href='/Repair/Index'">
                    <i class="fas fa-arrow-left"></i> Geri
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    
    button.btn-remove-image {
        background: #dc3545 !important;
        color: white !important;
        border: none !important;
        width: 34px !important;
        height: 34px !important;
        border-radius: 8px !important;
        font-size: 18px !important;
        font-weight: bold !important;
        padding: 0 !important;
        margin: 2px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
</style>

