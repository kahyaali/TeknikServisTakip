@section Scripts {
    <script>
        let newBeforeCount = 0;
        let newAfterCount = 0;
        let beforeUniqueId = 0;
        let afterUniqueId = 0;

        let pendingBeforeFiles = [];
        let pendingAfterFiles = [];

        $(document).ready(function() {
            updateCounters();
            initPriceFormat();
            setMinDeliveryDate();

            $('#CustomerSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var customerNo = selectedOption.data('customernumber');
                if (customerNo) {
                    $('#CustomerNumber').val(customerNo);
                } else {
                    $('#CustomerNumber').val('');
                }
            });

            // 1. TAHMİNİ TESLİM TARİHİ İÇİN GEÇMİŞ GÜNLERİ ENGELLER
            function setMinDeliveryDate() {
                var today = new Date().toISOString().split('T')[0];
                $('input[name="EstimatedDeliveryDate"]').attr('min', today);
            }

            // 2. FİYAT ALANINI ANLIK VE ÇIKIŞTA FORMATLAR (1.250,00 ₺)
            function initPriceFormat() {
                let priceInput = $('input[name="Price"]');

                // İlk açılışta 0 ise temiz bir görünüm ver
                if(priceInput.val() === "0" || priceInput.val() === "") {
                    priceInput.val("0,00").addClass("text-end");
                }

                priceInput.on('input', function() {
                    let val = $(this).val().replace(/[^0-9.,]/g, ''); // Sadece sayı, nokta, virgül
                    if ((val.match(/,/g) || []).length > 1) val = val.replace(/,+$/, "");
                    $(this).val(val);
                });

                priceInput.on('blur', function() {
                    let val = $(this).val().trim();
                    if (val === '' || val === '0') {
                        $(this).val('0,00');
                        return;
                    }
                    val = val.replace(/\./g, '').replace(',', '.');
                    let number = parseFloat(val);
                    if (!isNaN(number)) {
                        let formatted = number.toLocaleString('tr-TR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                        $(this).val(formatted);
                    } else {
                        $(this).val('0,00');
                    }
                });

                priceInput.on('focus', function() {
                    if ($(this).val() === '0,00') {
                        $(this).val('');
                    }
                });
            }

            // ========== TOPLU ÖNCESİ RESİM EKLEME ==========
            $('#addMultipleBefore').click(function() {
                var files = $('#multipleBeforeInput')[0].files;
                var totalBefore = newBeforeCount + pendingBeforeFiles.length;

                if (files.length === 0) {
                    Swal.fire('Uyarı!', 'Lütfen resim seçin!', 'warning');
                    return;
                }

                if (totalBefore + files.length > 5) {
                    var kalan = 5 - totalBefore;
                    Swal.fire('Uyarı!', `En fazla 5 resim ekleyebilirsiniz! ${kalan} adet daha ekleyebilirsiniz.`, 'warning');
                    return;
                }

                for (var i = 0; i < files.length; i++) {
                    pendingBeforeFiles.push(files[i]);
                }

                updateMultipleBeforeList();
                $('#multipleBeforeInput').val('');
                updateCounters();
            });

            function updateMultipleBeforeList() {
                var listDiv = $('#multipleBeforeList');
                listDiv.empty();
                if (pendingBeforeFiles.length > 0) {
                    listDiv.html('<strong>Seçilenler:</strong> <button type="button" id="selectAllPendingBefore" class="select-all-btn" style="background:#0d6efd; border:none; color:white; padding:2px 8px; border-radius:4px; margin-left:5px;">Tümünü Seç</button> <button type="button" id="deleteSelectedPendingBefore" class="btn-delete-selected" style="background:#dc3545; border:none; color:white; padding:2px 8px; border-radius:4px; margin-left:5px;">Seçilenleri Sil</button><br/>');
                    for (var i = 0; i < pendingBeforeFiles.length; i++) {
                        listDiv.append(`<span class="pending-before-item" data-index="${i}" style="cursor:pointer; display:inline-block; margin:2px; padding:2px 5px; border:1px solid #ccc; border-radius:4px;">${pendingBeforeFiles[i].name} <button type="button" class="remove-pending-before" data-index="${i}" style="background:none; border:none; color:red; cursor:pointer; font-weight:bold;">×</button></span>`);
                    }
                } else {
                    listDiv.html('');
                }

                $('.pending-before-item').off('click').on('click', function(e) {
                    if ($(e.target).hasClass('remove-pending-before')) return;
                    $(this).toggleClass('selected').css('background-color', $(this).hasClass('selected') ? '#e2e3e5' : 'transparent');
                });

                $('#selectAllPendingBefore').off('click').on('click', function() {
                    $('.pending-before-item').addClass('selected').css('background-color', '#e2e3e5');
                });

                $('#deleteSelectedPendingBefore').off('click').on('click', function() {
                    var selectedIndexes = [];
                    $('.pending-before-item.selected').each(function() {
                        selectedIndexes.push($(this).data('index'));
                    });

                    if (selectedIndexes.length === 0) {
                        Swal.fire('Uyarı', 'Silmek için resim seçin!', 'warning');
                        return;
                    }

                    Swal.fire({
                        title: `${selectedIndexes.length} resim silinecek!`,
                        text: 'Bu işlem geri alınamaz!',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        confirmButtonText: 'Evet, Sil!',
                        cancelButtonText: 'İptal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            selectedIndexes.sort((a, b) => b - a);
                            for (var idx of selectedIndexes) {
                                pendingBeforeFiles.splice(idx, 1);
                            }
                            updateMultipleBeforeList();
                            updateCounters();
                            Swal.fire('Silindi!', `${selectedIndexes.length} resim silindi.`, 'success');
                        }
                    });
                });

                $('.remove-pending-before').off('click').on('click', function(e) {
                    e.stopPropagation();
                    var index = $(this).data('index');
                    pendingBeforeFiles.splice(index, 1);
                    updateMultipleBeforeList();
                    updateCounters();
                });
            }

            // ========== TOPLU SONRASI RESİM EKLEME ==========
            $('#addMultipleAfter').click(function() {
                var files = $('#multipleAfterInput')[0].files;
                var totalAfter = newAfterCount + pendingAfterFiles.length;

                if (files.length === 0) {
                    Swal.fire('Uyarı!', 'Lütfen resim seçin!', 'warning');
                    return;
                }

                if (totalAfter + files.length > 5) {
                    var kalan = 5 - totalAfter;
                    Swal.fire('Uyarı!', `En fazla 5 resim ekleyebilirsiniz! ${kalan} adet daha ekleyebilirsiniz.`, 'warning');
                    return;
                }

                for (var i = 0; i < files.length; i++) {
                    pendingAfterFiles.push(files[i]);
                }

                updateMultipleAfterList();
                $('#multipleAfterInput').val('');
                updateCounters();
            });

            function updateMultipleAfterList() {
                var listDiv = $('#multipleAfterList');
                listDiv.empty();
                if (pendingAfterFiles.length > 0) {
                    listDiv.html('<strong>Seçilenler:</strong> <button type="button" id="selectAllPendingAfter" class="select-all-btn" style="background:#0d6efd; border:none; color:white; padding:2px 8px; border-radius:4px; margin-left:5px;">Tümünü Seç</button> <button type="button" id="deleteSelectedPendingAfter" class="btn-delete-selected" style="background:#dc3545; border:none; color:white; padding:2px 8px; border-radius:4px; margin-left:5px;">Seçilenleri Sil</button><br/>');
                    for (var i = 0; i < pendingAfterFiles.length; i++) {
                        listDiv.append(`<span class="pending-after-item" data-index="${i}" style="cursor:pointer; display:inline-block; margin:2px; padding:2px 5px; border:1px solid #ccc; border-radius:4px;">${pendingAfterFiles[i].name} <button type="button" class="remove-pending-after" data-index="${i}" style="background:none; border:none; color:red; cursor:pointer; font-weight:bold;">×</button></span>`);
                    }
                } else {
                    listDiv.html('');
                }

                $('.pending-after-item').off('click').on('click', function(e) {
                    if ($(e.target).hasClass('remove-pending-after')) return;
                    $(this).toggleClass('selected').css('background-color', $(this).hasClass('selected') ? '#e2e3e5' : 'transparent');
                });

                $('#selectAllPendingAfter').off('click').on('click', function() {
                    $('.pending-after-item').addClass('selected').css('background-color', '#e2e3e5');
                });

                $('#deleteSelectedPendingAfter').off('click').on('click', function() {
                    var selectedIndexes = [];
                    $('.pending-after-item.selected').each(function() {
                        selectedIndexes.push($(this).data('index'));
                    });

                    if (selectedIndexes.length === 0) {
                        Swal.fire('Uyarı', 'Silmek için resim seçin!', 'warning');
                        return;
                    }

                    Swal.fire({
                        title: `${selectedIndexes.length} resim silinecek!`,
                        text: 'Bu işlem geri alınamaz!',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        confirmButtonText: 'Evet, Sil!',
                        cancelButtonText: 'İptal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            selectedIndexes.sort((a, b) => b - a);
                            for (var idx of selectedIndexes) {
                                pendingAfterFiles.splice(idx, 1);
                            }
                            updateMultipleAfterList();
                            updateCounters();
                            Swal.fire('Silindi!', `${selectedIndexes.length} resim silindi.`, 'success');
                        }
                    });
                });

                $('.remove-pending-after').off('click').on('click', function(e) {
                    e.stopPropagation();
                    var index = $(this).data('index');
                    pendingAfterFiles.splice(index, 1);
                    updateMultipleAfterList();
                    updateCounters();
                });
            }

            // ========== TEK TEK ÖNCESİ RESİM EKLEME ==========
            $('#addBeforeImage').click(function() {
                var totalBefore = newBeforeCount + pendingBeforeFiles.length;

                if (totalBefore >= 5) {
                    Swal.fire('Uyarı!', 'En fazla 5 öncesi resmi ekleyebilirsiniz!', 'warning');
                    return;
                }

                beforeUniqueId++;

                // Input ve butonu dikeyde tam hizalamak için d-flex ve align-items-center eklendi
                $('#beforeImagesContainer').append(`
                    <div class="image-row d-flex align-items-center mb-2" id="beforeRow${beforeUniqueId}">
                        <input type="file" name="BeforeImages" class="form-control me-2" accept="image/*" />
                        <button type="button" class="btn btn-danger remove-before" data-id="${beforeUniqueId}">X</button>
                    </div>
                `);

                newBeforeCount = $('#beforeImagesContainer').children('.image-row').length;
                updateCounters();
            });

            $(document).on('click', '.remove-before', function() {
                var id = $(this).data('id');
                $(`#beforeRow${id}`).remove();
                newBeforeCount = $('#beforeImagesContainer').children('.image-row').length;
                updateCounters();
            });

            // ========== TEK TEK SONRASI RESİM EKLEME ==========
            $('#addAfterImage').click(function() {
                var totalAfter = newAfterCount + pendingAfterFiles.length;

                if (totalAfter >= 5) {
                    Swal.fire('Uyarı!', 'En fazla 5 sonrası resmi ekleyebilirsiniz!', 'warning');
                    return;
                }

                afterUniqueId++;

                // Input ve butonu dikeyde tam hizalamak için d-flex ve align-items-center eklendi
                $('#afterImagesContainer').append(`
                    <div class="image-row d-flex align-items-center mb-2" id="afterRow${afterUniqueId}">
                        <input type="file" name="AfterImages" class="form-control me-2" accept="image/*" />
                        <button type="button" class="btn btn-danger remove-after" data-id="${afterUniqueId}">X</button>
                    </div>
                `);

                newAfterCount = $('#afterImagesContainer').children('.image-row').length;
                updateCounters();
            });

            $(document).on('click', '.remove-after', function() {
                var id = $(this).data('id');
                $(`#afterRow${id}`).remove();
                newAfterCount = $('#afterImagesContainer').children('.image-row').length;
                updateCounters();
            });

            // ========== FORM GÖNDERME (FORMATLANMIŞ FİYATI ARKA PLANDA DÜZELTİR) ==========
            $('#addRepairForm').on('submit', function(e) {
                e.preventDefault();

                var totalBefore = newBeforeCount + pendingBeforeFiles.length;
                var totalAfter = newAfterCount + pendingAfterFiles.length;

                if (totalBefore > 5) {
                    Swal.fire('Hata!', 'Öncesi resim sayısı 5\'i geçemez!', 'error');
                    return false;
                }

                if (totalAfter > 5) {
                    Swal.fire('Hata!', 'Sonrası resim sayısı 5\'i geçemez!', 'error');
                    return false;
                }

                var formData = new FormData(this);

                // Ekrandaki "1.250,00" değerini backend'in (decimal) anlayacağı "1250.50" formatına çevirip öyle gönderiyoruz.
                let rawPrice = $('input[name="Price"]').val().replace(/\./g, '').replace(',', '.');
                formData.set('Price', rawPrice);

                for (var i = 0; i < pendingBeforeFiles.length; i++) {
                    formData.append('BeforeImages', pendingBeforeFiles[i]);
                }

                for (var i = 0; i < pendingAfterFiles.length; i++) {
                    formData.append('AfterImages', pendingAfterFiles[i]);
                }

                Swal.fire({
                    title: 'Kaydediliyor...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                $.ajax({
                    url: '/Repair/Create',
                    type: 'POST',
                    data: formData,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            Swal.fire('Başarılı!', 'Tamir kaydı eklendi.', 'success').then(() => {
                                window.location.href = '/Repair/Index';
                            });
                        } else {
                            Swal.fire('Hata!', response.message || 'Bir sorun oluştu.', 'error');
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Hata!', xhr.responseJSON?.message || 'Bir sorun oluştu.', 'error');
                    }
                });

                return false;
            });

            function updateCounters() {
                var totalBefore = newBeforeCount + pendingBeforeFiles.length;
                var totalAfter = newAfterCount + pendingAfterFiles.length;

                $('#beforeCounter').text(`${totalBefore} / 5 resim`);
                $('#afterCounter').text(`${totalAfter} / 5 resim`);

                if (totalBefore >= 5) {
                    $('#addBeforeImage, #addMultipleBefore').prop('disabled', true).css('opacity', '0.5');
                } else {
                    $('#addBeforeImage, #addMultipleBefore').prop('disabled', false).css('opacity', '1');
                }

                if (totalAfter >= 5) {
                    $('#addAfterImage, #addMultipleAfter').prop('disabled', true).css('opacity', '0.5');
                } else {
                    $('#addAfterImage, #addMultipleAfter').prop('disabled', false).css('opacity', '1');
                }
            }
        });
    </script>
}