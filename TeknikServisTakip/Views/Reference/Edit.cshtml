@model Entities.Concrete.Reference
@{
    ViewData["Title"] = "Referans Düzenle";
}

<div class="content-wrapper">
    <h1><i class="fas fa-edit"></i> Referans Düzenle</h1>

    <form method="post" asp-action="Edit" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Müşteri Adı</label>
                    <input type="text" asp-for="CustomerName" class="form-control" required />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ünvan (Opsiyonel)</label>
                    <input type="text" asp-for="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Yorum</label>
                    <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Müşteri Fotoğrafı / Logosu</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mt-2">
                            <img src="@Model.ImagePath" style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%;" />
                            <br />
                            <small class="text-muted">Mevcut resim. Yeni resim seçerseniz değişir.</small>
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label">Sıra</label>
                    <input type="number" asp-for="Order" class="form-control" value="0" />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" asp-for="IsActive" class="form-check-input" />
                    <label class="form-check-label">Aktif</label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Geri</a>
        </div>
    </form>
</div>