</style>

@section Scripts {
    <script>
        let customerTable;
        let signalRConnectionId = "";

        // ========== LAYOUT'TAKİ SİGNALR NESNESİNE BAĞLANMA ==========
        // Layout'ta tanımlı olan 'connection' nesnesini dinliyoruz.
        if (typeof connection !== 'undefined') {

            // Excel yükleme aşamalarını canlı dinle
            connection.on("ReceiveProgress", function (percent, message) {
                $('#importProgress').show();
                $('#progressBar').css('width', percent + '%').attr('aria-valuenow', percent);
                $('#progressPercentText').text(percent + '%');
                $('#progressText').html(`<i class="fas fa-spinner fa-spin me-2"></i> ${message}`);
            });

            // Sayfa açıldığında bağlantı sağlandıysa ID'yi hemen kap
            if (connection.state === "Connected" || connection.connectionId) {
                signalRConnectionId = connection.connectionId;
                console.log("Mevcut SignalR ID Alındı: " + signalRConnectionId);
            }
        }

        $(document).ready(function() {
            loadStatistics();
            initDataTable();

            // Eğer sayfa ilk açıldığında bağlantı ID'si henüz oluşmadıysa 1 saniye sonra tekrar dene
            setTimeout(function() {
                if(!signalRConnectionId && typeof connection !== 'undefined') {
                    signalRConnectionId = connection.connectionId || "";
                    console.log("Gecikmeli SignalR ID Kontrolü: " + signalRConnectionId);
                }
            }, 1000);
        });

        function loadStatistics() {
            $.ajax({
                url: '/Customer/GetStatistics',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        $('#totalCount').text(response.totalCount);
                        $('#last30DaysCount').text(response.last30DaysCount);
                        $('#growthRate').text(response.growthRate + '%');
                        $('#activeCount').text(response.activeCount);
                    }
                }
            });
        }

        function initDataTable() {
            if ($.fn.dataTable.isDataTable('#customerTable')) {
                $('#customerTable').DataTable().destroy();
            }

            customerTable = $('#customerTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/Customer/GetCustomersJson',
                    type: 'POST',
                    data: function(d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search?.value || ''
                        };
                    }
                },
                columns: [
                    {
                        data: null,
                        render: function(data, type, row, meta) {
                            return meta.row + 1 + meta.settings._iDisplayStart;
                        }
                    },
                    { data: 'customerNumber' },
                    {
                        data: 'fullName',
                        render: function(data, type, row) {
                            return '<a href="/Customer/Details/' + row.id + '" class="text-primary fw-bold"><i class="fas fa-user-circle me-2"></i>' + data + '</a>';
                        }
                    },
                    { data: 'email' },
                    { data: 'phoneNumber' },
                    { data: 'addressShort' },
                    {
                        data: 'isActive',
                        render: function(data) {
                            return data ? '<span class="badge-active">Aktif</span>' : '<span class="badge-passive">Pasif</span>';
                        }
                    },
                    { data: 'createdAt' },
                    {
                        data: null,
                        render: function(data) {
                            return '<a href="/Customer/Edit/' + data.id + '" class="btn-edit">Düzenle</a>' +
                                   '<button onclick="toggleStatus(\'' + data.id + '\', ' + data.isActive + ')" class="btn-toggle">' + (data.isActive ? 'Pasif Yap' : 'Aktif Yap') + '</button>' +
                                   '<button onclick="deleteCustomer(\'' + data.id + '\', \'' + (data.fullName || '').replace(/'/g, "\\'") + '\')" class="btn-sil">Sil</button>';
                        }
                    }
                ],
                pageLength: 10,
                language: { url: '/datatables/tr.json' },
                order: [[1, 'asc']]
            });
        }

        // ========== EXCEL IMPORT ==========
        $('#importBtn').on('click', function() {
            var fileInput = document.getElementById('excelFileInput');
            var file = fileInput.files[0];
            var token = $('input[name="__RequestVerificationToken"]').val();

            if (!file) {
                Swal.fire('Uyarı', 'Lütfen bir Excel dosyası seçin!', 'warning');
                return;
            }

            var extension = file.name.split('.').pop().toLowerCase();
            if (extension !== 'xlsx' && extension !== 'xls') {
                Swal.fire('Hata', 'Sadece .xlsx veya .xls formatındaki dosyalar yüklenebilir!', 'error');
                return;
            }

            var formData = new FormData();
            formData.append('excelFile', file);
            formData.append('__RequestVerificationToken', token);

            // Eğer ID hala boşsa Layout nesnesinden son bir kez zorla çekiyoruz
            if(!signalRConnectionId && typeof connection !== 'undefined') {
                signalRConnectionId = connection.connectionId || "";
            }

            formData.append('signalRConnectionId', signalRConnectionId);

            var $btn = $(this);
            var $cancelBtn = $('#modalCancelBtn');
            var $closeBtn = $('#modalCloseBtn');
            var $progress = $('#importProgress');
            var $fileGroup = $('#fileInputGroup');
            var $alertInfo = $('#modalAlertInfo');

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Yükleniyor...');
            $cancelBtn.prop('disabled', true);
            $closeBtn.hide();
            $fileGroup.hide();
            $alertInfo.hide();
            $progress.show();

            $('#progressBar').css('width', '0%').attr('aria-valuenow', 0);
            $('#progressPercentText').text('0%');
            $('#progressText').html('<i class="fas fa-spinner fa-spin me-2"></i> Veriler analiz ediliyor...');

            $.ajax({
                url: '/Account/ImportCustomers',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                headers: { 'RequestVerificationToken': token },
                success: function(response) {
                    if (response.success) {
                        $('#importExcelModal').modal('hide');

                        Swal.fire({
                            icon: response.hasErrors ? 'warning' : 'success',
                            title: response.hasErrors ? 'Kısmen Tamamlandı' : 'Tamamlandı!',
                            html: `<b>${response.message}</b><br>Başarılı: ${response.importedCount} / Toplam: ${response.totalRows}`,
                            confirmButtonText: 'Tamam'
                        }).then(() => {
                            customerTable.ajax.reload();
                            loadStatistics();
                            resetModalState();
                        });
                    } else {
                        Swal.fire('Hata!', response.message, 'error');
                        resetModalState();
                    }
                },
                error: function() {
                    Swal.fire('Hata!', 'Beklenmedik bir hata oluştu veya bağlantı koptu.', 'error');
                    resetModalState();
                }
            });
        });

        function resetModalState() {
            $('#importBtn').prop('disabled', false).html('<i class="fas fa-file-excel"></i> İçe Aktar');
            $('#modalCancelBtn').prop('disabled', false);
            $('#modalCloseBtn').show();
            $('#fileInputGroup').show();
            $('#modalAlertInfo').show();
            $('#importProgress').hide();
            $('#excelFileInput').val('');
            $('#progressBar').css('width', '0%');
            $('#progressPercentText').text('0%');
        }

        function toggleStatus(id, isActive) {
            var newStatus = isActive ? 'Pasif' : 'Aktif';
            Swal.fire({
                title: 'Durum Değiştir',
                html: `<b>Müşteri durumunu "${newStatus}" yapmak istediğinize emin misiniz?</b>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#f59e0b',
                confirmButtonText: 'Evet, Değiştir!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'İşlem yapılıyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    $.ajax({
                        url: '/Customer/ToggleCustomerStatus',
                        type: 'POST',
                        data: { id: id },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire('Başarılı!', res.message, 'success').then(() => {
                                    customerTable.ajax.reload();
                                    loadStatistics();
                                });
                            } else {
                                Swal.fire('Hata!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Hata!', 'Bir sorun oluştu.', 'error');
                        }
                    });
                }
            });
        }

        function deleteCustomer(id, fullName) {
            Swal.fire({
                title: 'Müşteri Silinecek!',
                html: `<div style="font-size:16px;"><b>${fullName}</b><br>adlı müşteriyi silmek üzeresiniz!</div><div class="mt-2 text-danger">Bu işlem <b>GERİ ALINAMAZ</b>!</div>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'İşlem yapılıyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                    $.ajax({
                        url: '/Customer/Delete',
                        type: 'POST',
                        data: { id: id },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire('Silindi!', res.message, 'success').then(() => {
                                    customerTable.ajax.reload();
                                    loadStatistics();
                                });
                            } else {
                                Swal.fire('Hata!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Hata!', 'Bir sorun oluştu.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}